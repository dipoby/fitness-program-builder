# Copy this file to .env and fill in real values. .env is git-ignored.
#
# Required to run Claude Code itself against the Anthropic API.
# Not required by any file in this repository directly — the exercise-db MCP
# server and all hooks/scripts use no external credentials by design (the
# exercise catalogue is a bundled local dataset, not a third-party API).
ANTHROPIC_API_KEY=sk-ant-...

# Optional: only needed if research-agent's web search is run through an
# API-based search provider rather than Claude Code's built-in WebSearch tool.
# Leave unset to rely on the built-in tool.
# BRAVE_SEARCH_API_KEY=
