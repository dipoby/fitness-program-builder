{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "exercise_selection.schema.json",
  "title": "exercise selection artifact",
  "type": "object",
  "required": ["run_id", "phase", "produced_by", "version", "status", "created_at", "payload"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "phase": {"const": "exercise_selection"},
    "produced_by": {"type": "string"},
    "version": {"type": "integer", "minimum": 1},
    "status": {"enum": ["draft", "validated", "failed"]},
    "created_at": {"type": "string", "format": "date-time"},
    "payload": {
      "type": "object",
      "required": ["sessions", "equipment_used_overall"],
      "properties": {
        "sessions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["session_id", "exercises"],
            "properties": {
              "session_id": {"type": "string"},
              "exercises": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["exercise_id", "name", "sets", "reps_range", "rest_seconds", "equipment_used", "source"],
                  "properties": {
                    "exercise_id": {"type": "string"},
                    "name": {"type": "string"},
                    "sets": {"type": "integer", "minimum": 1, "maximum": 10},
                    "reps_range": {"type": "string"},
                    "rest_seconds": {"type": "integer", "minimum": 0, "maximum": 600},
                    "equipment_used": {"type": "array", "items": {"type": "string"}},
                    "source": {"enum": ["mcp_exercise_db", "mcp_substitution"]},
                    "substitution_reason": {"type": "string"}
                  }
                }
              }
            }
          }
        },
        "equipment_used_overall": {"type": "array", "items": {"type": "string"}},
        "safety_notes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
