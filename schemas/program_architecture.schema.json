{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "program_architecture.schema.json",
  "title": "program architecture artifact",
  "type": "object",
  "required": ["run_id", "phase", "produced_by", "version", "status", "created_at", "payload"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "phase": {"const": "architecture"},
    "produced_by": {"type": "string"},
    "version": {"type": "integer", "minimum": 1},
    "status": {"enum": ["draft", "validated", "failed"]},
    "created_at": {"type": "string", "format": "date-time"},
    "payload": {
      "type": "object",
      "required": ["split_type", "weeks_total", "sessions"],
      "properties": {
        "split_type": {"type": "string"},
        "weeks_total": {"type": "integer", "minimum": 1, "maximum": 52},
        "sessions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["session_id", "day_label", "focus", "target_minutes", "movement_patterns"],
            "properties": {
              "session_id": {"type": "string"},
              "day_label": {"type": "string"},
              "focus": {"type": "string"},
              "target_minutes": {"type": "integer", "minimum": 10, "maximum": 180},
              "movement_patterns": {
                "type": "array",
                "items": {"enum": ["push", "pull", "squat", "hinge", "carry", "core", "accessory"]}
              }
            }
          }
        },
        "periodization_notes": {"type": "string"},
        "research_citations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["claim", "source"],
            "properties": {
              "claim": {"type": "string"},
              "source": {"type": "string"}
            }
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
